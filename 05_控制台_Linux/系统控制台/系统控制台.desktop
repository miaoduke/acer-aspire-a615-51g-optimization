[Desktop Entry]
Version=1.0
Type=Application
Name=系统控制台
GenericName=Power & Thermal Console
Comment=Acer A615-51G 电源与散热控制台（监控 + 场景切换 + 调优）
# 用包装脚本启动：含依赖预检 + 单实例检查 + 日志，比直接跑 console.py 稳
Exec=/home/<USER>/桌面/系统控制台/启动控制台.sh
Path=/home/<USER>/桌面/系统控制台
Icon=utilities-system-monitor
Terminal=false
Categories=System;Monitor;
Keywords=power;battery;thermal;undervolt;cpu;电源;电池;散热;降压
StartupNotify=true
StartupWMClass=console.py
